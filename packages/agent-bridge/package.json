{
	"name": "agent-bridge",
	"version": "0.1.0",
	"description": "Run typed commands against a running React Native app from a CLI or the Metro dev tools.",
	"main": "build/index.js",
	"types": "build/index.d.ts",
	"sideEffects": false,
	"scripts": {
		"build": "expo-module build",
		"build:all": "expo-module prepare && pnpm run web:export",
		"clean": "expo-module clean",
		"prepare": "expo-module prepare",
		"prepublishOnly": "expo-module prepare && expo-module prepublishOnly && pnpm run web:export",
		"web:dev": "cd webui && npx expo start -w",
		"web:export": "./scripts/build-webui.js",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"expo",
		"devtools"
	],
	"files": [
		"build",
		"dist",
		"expo-module.config.json"
	],
	"license": "MIT",
	"dependencies": {},
	"devDependencies": {
		"@types/react": "~19.2.2",
		"expo": "~57.0.22",
		"expo-module-scripts": "^4.1.7",
		"react": "19.2.3",
		"react-native": "0.86.3",
		"typescript": "~5.9.3",
		"zod": "^4.6.2"
	},
	"peerDependencies": {
		"expo": ">=53.0.0",
		"react": "*",
		"zod": "^4.0.0"
	},
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"default": "./build/index.js"
		},
		"./core": {
			"types": "./build/core/index.d.ts",
			"default": "./build/core/index.js"
		},
		"./package.json": "./package.json"
	},
	"peerDependenciesMeta": {
		"@apollo/client": {
			"optional": true
		},
		"@react-navigation/native": {
			"optional": true
		},
		"zustand": {
			"optional": true
		}
	}
}
