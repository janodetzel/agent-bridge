{
	"name": "agent-bridge",
	"version": "0.1.0",
	"description": "Run typed commands against a running React Native app from a CLI or the Metro dev tools.",
	"main": "build/index.js",
	"types": "build/index.d.ts",
	"sideEffects": false,
	"scripts": {
		"build": "EXPO_NONINTERACTIVE=1 expo-module build && EXPO_NONINTERACTIVE=1 expo-module build cli && pnpm run build:mcp",
		"build:all": "expo-module prepare && pnpm run build:mcp && pnpm run web:export",
		"build:mcp": "tsc -p mcp/tsconfig.json",
		"clean": "expo-module clean",
		"prepare": "expo-module prepare && pnpm run build:mcp",
		"prepublishOnly": "expo-module prepare && expo-module prepublishOnly && pnpm run build:mcp && pnpm run web:export",
		"web:dev": "cd webui && npx expo start -w",
		"web:export": "./scripts/build-webui.js",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"expo",
		"devtools"
	],
	"files": [
		"build",
		"dist",
		"metro",
		"expo-module.config.json"
	],
	"license": "MIT",
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"ws": "^8.21.3"
	},
	"devDependencies": {
		"@apollo/client": "^4.3.0",
		"@react-navigation/native": "^7.3.18",
		"@types/react": "~19.2.2",
		"@types/ws": "^8.18.1",
		"expo": "~57.0.22",
		"expo-module-scripts": "^4.1.7",
		"graphql": "^17.0.2",
		"react": "19.2.3",
		"react-native": "0.86.3",
		"typescript": "~5.9.3",
		"zod": "^4.6.2",
		"zustand": "^5.0.15"
	},
	"peerDependencies": {
		"expo": ">=53.0.0",
		"react": "*",
		"zod": "^4.0.0"
	},
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"default": "./build/index.js"
		},
		"./core": {
			"types": "./build/core/index.d.ts",
			"default": "./build/core/index.js"
		},
		"./protocol": {
			"types": "./build/core/protocol.d.ts",
			"default": "./build/core/protocol.js"
		},
		"./groups": {
			"types": "./build/groups.d.ts",
			"default": "./build/groups.js"
		},
		"./metro": {
			"types": "./metro/index.d.ts",
			"default": "./metro/index.cjs"
		},
		"./react-navigation": {
			"types": "./build/adapters/react-navigation.d.ts",
			"default": "./build/adapters/react-navigation.js"
		},
		"./apollo": {
			"types": "./build/adapters/apollo.d.ts",
			"default": "./build/adapters/apollo.js"
		},
		"./zustand": {
			"types": "./build/adapters/zustand.d.ts",
			"default": "./build/adapters/zustand.js"
		},
		"./package.json": "./package.json"
	},
	"peerDependenciesMeta": {
		"@apollo/client": {
			"optional": true
		},
		"@react-navigation/native": {
			"optional": true
		},
		"zustand": {
			"optional": true
		}
	},
	"bin": {
		"agent-bridge": "./build/cli/index.js",
		"agent-bridge-mcp": "./build/mcp/index.js"
	}
}
