{
	"name": "@janodetzel/feature-kit",
	"version": "0.1.1",
	"description": "A small architecture pattern: features declare their entry points once, as named async methods with schema-validated arguments, and a lint plugin keeps the rules that make them reachable from outside React.",
	"author": "Jano Detzel <jano@janodetzel.com>",
	"homepage": "https://github.com/janodetzel/app-commands/tree/main/packages/feature-kit#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/janodetzel/app-commands.git",
		"directory": "packages/feature-kit"
	},
	"bugs": {
		"url": "https://github.com/janodetzel/app-commands/issues"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "public"
	},
	"main": "build/index.js",
	"types": "build/index.d.ts",
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"clean": "rm -rf build",
		"prepare": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"files": [
		"build",
		"eslint",
		"depcruise"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.20.2",
		"eslint": "^10.10.0",
		"typescript": "~5.9.3",
		"zod": "^4.6.2"
	},
	"peerDependencies": {
		"zod": "^4.0.0"
	},
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"default": "./build/index.js"
		},
		"./eslint": {
			"types": "./eslint/index.d.mts",
			"default": "./eslint/index.mjs"
		},
		"./depcruise": {
			"default": "./depcruise/index.cjs"
		},
		"./package.json": "./package.json"
	}
}
